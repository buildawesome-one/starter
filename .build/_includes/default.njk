{% extends 'blades/html.njk' %}

{% if not site.prod %}
  {% set site = site | attr_set('styles', site.styles | join('|') | replace('https://cdn.jsdelivr.net/npm/@anyblades/blades@3/css', '') | split('|')) %}
{% endif %}

{% set content_for_header %}
  <meta name="generator" content="{{ site.generator }}">
  <meta property="og:title" content="{{ title | d(site.title) | striptags }}">
  <meta name="twitter:card" content="summary_large_image">
  <style>
    object { vertical-align: middle } /*TODO: move to blades.css */
    body > footer { text-align: center; padding-bottom: 3rem; font-size: medium }
  </style>
  {{ content_for_header | safe }}
{% endset %}

{% block body %}
  <nav class="container">
    <ul><li><a href="/">{{ site.logo | safe }}</a></li></ul>
    {{ collections.all | eleventyNavigation | eleventyNavigationToHtml | safe }}
  </nav>
  <main class="container breakout-all">
    {% if title %}<h1>{{ title }}</h1>{% endif %}
    {% if description %}<p><big>{{ description }}</big></p>{% endif %}
    {{ content | safe }}
  </main>
  <hr>
  <footer>{{ site.footer | safe }} © {{ site.year }}</footer>
{% endblock %}
